<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:startColor="#55ffd21a" android:endColor="#22ffd21a" android:angle="0.0" />
            <stroke android:width="1.0dip" android:color="#ffffd21a" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="#301f1f1f" android:endColor="#18070707" android:angle="135.0" />
            <stroke android:width="1.0dip" android:color="#55ffd21a" />
        </shape>
    </item>
</selector>