<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#ff382e0b" />
            <stroke android:width="2.0dip" android:color="#ffffd21a" />
            <corners android:radius="7.0dip" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="#ff201d12" android:endColor="#ff151515" android:angle="90.0" />
            <stroke android:width="1.0dip" android:color="#ffffd21a" />
            <corners android:radius="7.0dip" />
        </shape>
    </item>
</selector>