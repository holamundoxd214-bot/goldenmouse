<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#ff40330a" />
            <corners android:radius="8.0dip" />
            <stroke android:width="2.0dip" android:color="#ffffd21a" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="#ff282313" android:endColor="#ff151515" android:angle="90.0" />
            <corners android:radius="8.0dip" />
            <stroke android:width="1.0dip" android:color="#ffd3ae22" />
        </shape>
    </item>
</selector>